generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Farm {
  id        Int      @id @default(autoincrement())
  name      String
  location  String?
  createdAt DateTime @default(now())

  fields    Field[]
}

model Field {
  id        Int      @id @default(autoincrement())
  name      String
  hectares  Float
  createdAt DateTime @default(now())

  farmId    Int
  farm      Farm     @relation(fields: [farmId], references: [id])

  @@index([farmId])
}
